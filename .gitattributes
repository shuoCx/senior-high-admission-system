# 统一换行符：仓库内一律 LF，Windows 检出时自动转 CRLF
* text=auto eol=lf

# 脚本类在 Windows 使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.xlsx binary
*.xls  binary
*.docx binary
*.pdf  binary

# 明确语言类型，GitHub 统计更准确
*.java linguist-language=Java
*.vue  linguist-language=Vue